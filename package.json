{
  "name": "abyss-ocean",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -k 'pnpm dev:api' 'pnpm dev:web'",
    "dev:api": "node --env-file-if-exists=.env --import tsx apps/api/src/main.ts",
    "dev:web": "next dev apps/web --hostname 0.0.0.0",
    "build": "node --env-file-if-exists=.env scripts/generate.mjs && tsc --noEmit && next build apps/web",
    "start:api": "node --env-file-if-exists=.env --import tsx apps/api/src/main.ts",
    "start:web": "next start apps/web --hostname 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "node --env-file-if-exists=.env scripts/generate.mjs",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "check": "tsc --noEmit",
    "db:local": "node --import tsx scripts/local-db.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.16.24",
    "@colyseus/ws-transport": "0.16.5",
    "@nestjs/common": "11.1.17",
    "@nestjs/core": "11.1.17",
    "@nestjs/platform-express": "11.1.17",
    "@prisma/adapter-pg": "6.19.2",
    "@prisma/client": "6.19.2",
    "@solana/wallet-standard-util": "1.1.3",
    "@solana/web3.js": "1.98.4",
    "@wallet-standard/app": "1.1.0",
    "bs58": "6.0.0",
    "bullmq": "5.71.0",
    "colyseus.js": "0.16.22",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "express-rate-limit": "8.3.1",
    "helmet": "8.1.0",
    "ioredis": "5.10.0",
    "next": "15.5.12",
    "pg": "8.16.3",
    "phaser": "3.90.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tweetnacl": "1.0.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.19.15",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "9.2.1",
    "embedded-postgres": "18.1.0-beta.16",
    "prisma": "6.19.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
